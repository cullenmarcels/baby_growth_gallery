generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

enum FamilyMembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum FamilyActivityVisibility {
  ACTIVE
  TOMBSTONED
}

enum BabySex {
  MALE
  FEMALE
}

enum BabyProfileStatus {
  ACTIVE
  ARCHIVED
  PURGING
}

enum PhotoStatus {
  AWAITING_UPLOAD
  QUEUED
  PROCESSING
  DRAFT
  PUBLISHED
  TRASHED
  FAILED
  PURGING
}

enum PhotoSourceFormat {
  JPEG
  PNG
  WEBP
  HEIC
  HEIF
}

enum PhotoVariantKind {
  THUMBNAIL
  DISPLAY
  ARCHIVE
}

enum MilestoneSource {
  TEMPLATE
  CUSTOM
}

enum MilestoneState {
  PENDING
  COMPLETED
}

model Account {
  id                String             @id @default(uuid()) @db.Uuid
  phoneE164         String             @unique @map("phone_e164") @db.VarChar(16)
  passwordHash      String             @map("password_hash")
  displayName       String?            @map("display_name") @db.VarChar(80)
  status            AccountStatus      @default(ACTIVE)
  authVersion       Int                @default(1) @map("auth_version")
  phoneVerifiedAt   DateTime           @map("phone_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime           @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  legalAcceptances  LegalAcceptance[]
  createdFamilies   Family[]           @relation("FamilyCreator")
  familyMemberships FamilyMembership[]
  usedInvitations   FamilyInvitation[] @relation("InvitationUser")

  @@map("accounts")
}

model Family {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(40)
  createdByAccountId String             @map("created_by_account_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          Account            @relation("FamilyCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  memberships        FamilyMembership[]
  invitations        FamilyInvitation[]
  activities         FamilyActivity[]
  babies             BabyProfile[]
  photoUploadBatches PhotoUploadBatch[]
  photos             Photo[]
  milestones         Milestone[]

  @@index([createdByAccountId])
  @@map("families")
}

model FamilyMembership {
  id                  String                 @id @default(uuid()) @db.Uuid
  familyId            String                 @map("family_id") @db.Uuid
  accountId           String                 @map("account_id") @db.Uuid
  role                FamilyRole
  status              FamilyMembershipStatus @default(ACTIVE)
  displayName         String                 @map("display_name") @db.VarChar(30)
  joinedAt            DateTime               @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt              DateTime?              @map("left_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  family              Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  account             Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdInvitations  FamilyInvitation[]     @relation("InvitationCreator")
  activities          FamilyActivity[]       @relation("ActivityActor")
  createdBabies       BabyProfile[]          @relation("BabyCreator")
  createdPhotoBatches PhotoUploadBatch[]     @relation("PhotoBatchCreator")
  createdPhotos       Photo[]                @relation("PhotoCreator")
  trashedPhotos       Photo[]                @relation("PhotoTrashActor")
  createdMilestones   Milestone[]            @relation("MilestoneCreator")

  @@unique([familyId, accountId])
  @@index([accountId, status, joinedAt])
  @@index([familyId, status, role])
  @@map("family_memberships")
}

model FamilyInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  familyId              String           @map("family_id") @db.Uuid
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  tokenDigest           String           @unique @map("token_digest") @db.VarChar(64)
  role                  FamilyRole       @default(MEMBER)
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt                DateTime?        @map("used_at") @db.Timestamptz(3)
  usedByAccountId       String?          @map("used_by_account_id") @db.Uuid
  revokedAt             DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  family                Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy             FamilyMembership @relation("InvitationCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  usedBy                Account?         @relation("InvitationUser", fields: [usedByAccountId], references: [id], onDelete: SetNull)

  @@index([familyId, usedAt, revokedAt, expiresAt])
  @@index([createdByMembershipId])
  @@map("family_invitations")
}

model FamilyActivity {
  id                String                   @id @default(uuid()) @db.Uuid
  familyId          String                   @map("family_id") @db.Uuid
  actorMembershipId String?                  @map("actor_membership_id") @db.Uuid
  type              String                   @db.VarChar(64)
  schemaVersion     Int                      @default(1) @map("schema_version")
  subjectType       String?                  @map("subject_type") @db.VarChar(40)
  subjectId         String?                  @map("subject_id") @db.VarChar(64)
  summaryPayload    Json                     @map("summary_payload")
  visibility        FamilyActivityVisibility @default(ACTIVE)
  occurredAt        DateTime                 @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tombstonedAt      DateTime?                @map("tombstoned_at") @db.Timestamptz(3)
  family            Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor             FamilyMembership?        @relation("ActivityActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([familyId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorMembershipId])
  @@map("family_activities")
}

model BabyProfile {
  id                    String             @id @default(uuid()) @db.Uuid
  familyId              String             @map("family_id") @db.Uuid
  createdByMembershipId String             @map("created_by_membership_id") @db.Uuid
  nickname              String             @db.VarChar(30)
  birthDate             DateTime           @map("birth_date") @db.Date
  sex                   BabySex?
  avatarPhotoId         String?            @unique @map("avatar_photo_id") @db.Uuid
  status                BabyProfileStatus  @default(ACTIVE)
  archivedAt            DateTime?          @map("archived_at") @db.Timestamptz(3)
  purgeAfter            DateTime?          @map("purge_after") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  family                Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy             FamilyMembership   @relation("BabyCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  photoUploadBatches    PhotoUploadBatch[]
  photos                Photo[]
  avatarPhoto           Photo?              @relation("BabyAvatar", fields: [avatarPhotoId], references: [id], onDelete: SetNull)
  milestones            Milestone[]

  @@index([familyId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, purgeAfter])
  @@index([createdByMembershipId])
  @@map("baby_profiles")
}

model PhotoUploadBatch {
  id                    String           @id @default(uuid()) @db.Uuid
  familyId              String           @map("family_id") @db.Uuid
  babyId                String           @map("baby_id") @db.Uuid
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  family                Family           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  baby                  BabyProfile      @relation(fields: [babyId], references: [id], onDelete: Restrict)
  createdBy             FamilyMembership @relation("PhotoBatchCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  photos                Photo[]

  @@index([familyId, babyId, createdAt(sort: Desc)])
  @@index([createdByMembershipId, createdAt(sort: Desc)])
  @@map("photo_upload_batches")
}

model Photo {
  id                    String             @id @default(uuid()) @db.Uuid
  uploadBatchId         String             @map("upload_batch_id") @db.Uuid
  familyId              String             @map("family_id") @db.Uuid
  babyId                String             @map("baby_id") @db.Uuid
  createdByMembershipId String             @map("created_by_membership_id") @db.Uuid
  status                PhotoStatus        @default(AWAITING_UPLOAD)
  declaredContentType   String             @map("declared_content_type") @db.VarChar(100)
  declaredSizeBytes     Int                @map("declared_size_bytes")
  sourceFormat          PhotoSourceFormat? @map("source_format")
  sourceSizeBytes       Int?               @map("source_size_bytes")
  sourceSha256          String?            @map("source_sha256") @db.VarChar(64)
  sourceWidth           Int?               @map("source_width")
  sourceHeight          Int?               @map("source_height")
  title                 String?            @db.VarChar(80)
  description           String?            @db.VarChar(1000)
  capturedOn            DateTime           @map("captured_on") @db.Date
  location              String?            @db.VarChar(80)
  displayOrder          Int                @map("display_order")
  quarantineObjectKey   String?            @unique @map("quarantine_object_key") @db.VarChar(120)
  uploadWindowExpiresAt DateTime           @map("upload_window_expires_at") @db.Timestamptz(3)
  processingAttempts    Int                @default(0) @map("processing_attempts")
  processingLeaseUntil  DateTime?          @map("processing_lease_until") @db.Timestamptz(3)
  nextProcessingAt      DateTime?          @map("next_processing_at") @db.Timestamptz(3)
  failureCode           String?            @map("failure_code") @db.VarChar(64)
  draftExpiresAt        DateTime?          @map("draft_expires_at") @db.Timestamptz(3)
  publishedAt           DateTime?          @map("published_at") @db.Timestamptz(3)
  trashedAt             DateTime?          @map("trashed_at") @db.Timestamptz(3)
  trashedByMembershipId String?            @map("trashed_by_membership_id") @db.Uuid
  trashedByRole         FamilyRole?        @map("trashed_by_role")
  purgeAfter            DateTime?          @map("purge_after") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  uploadBatch           PhotoUploadBatch   @relation(fields: [uploadBatchId], references: [id], onDelete: Restrict)
  family                Family             @relation(fields: [familyId], references: [id], onDelete: Restrict)
  baby                  BabyProfile        @relation(fields: [babyId], references: [id], onDelete: Restrict)
  createdBy             FamilyMembership   @relation("PhotoCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  trashedBy             FamilyMembership?  @relation("PhotoTrashActor", fields: [trashedByMembershipId], references: [id], onDelete: Restrict)
  variants              PhotoVariant[]
  avatarForBaby         BabyProfile?        @relation("BabyAvatar")
  milestonePhotos       MilestonePhoto[]

  @@index([uploadBatchId, displayOrder])
  @@index([familyId, babyId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([familyId, babyId, status, capturedOn(sort: Desc), publishedAt(sort: Desc), id(sort: Desc)])
  @@index([createdByMembershipId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([trashedByMembershipId])
  @@index([status, nextProcessingAt, processingLeaseUntil])
  @@index([status, purgeAfter])
  @@map("photos")
}

model Milestone {
  id                    String           @id @default(uuid()) @db.Uuid
  familyId              String           @map("family_id") @db.Uuid
  babyId                String           @map("baby_id") @db.Uuid
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  source                MilestoneSource
  templateKey           String?          @map("template_key") @db.VarChar(64)
  title                 String           @db.VarChar(40)
  state                 MilestoneState   @default(PENDING)
  reminderOn            DateTime?        @map("reminder_on") @db.Date
  completedOn           DateTime?        @map("completed_on") @db.Date
  completionNote        String?          @map("completion_note") @db.VarChar(1000)
  completedAt           DateTime?        @map("completed_at") @db.Timestamptz(3)
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  family                Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  baby                  BabyProfile      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  createdBy             FamilyMembership @relation("MilestoneCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  photos                MilestonePhoto[]

  @@unique([babyId, templateKey])
  @@index([familyId, babyId, state, createdAt(sort: Desc), id(sort: Desc)])
  @@index([familyId, babyId, state, completedOn(sort: Desc), completedAt(sort: Desc), id(sort: Desc)])
  @@index([familyId, babyId, state, reminderOn, createdAt, id])
  @@index([createdByMembershipId])
  @@map("milestones")
}

model MilestonePhoto {
  milestoneId String    @map("milestone_id") @db.Uuid
  photoId     String    @map("photo_id") @db.Uuid
  displayOrder Int      @map("display_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  photo       Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([milestoneId, photoId])
  @@index([milestoneId, displayOrder])
  @@index([photoId])
  @@map("milestone_photos")
}

model PhotoVariant {
  id        String           @id @default(uuid()) @db.Uuid
  photoId   String           @map("photo_id") @db.Uuid
  kind      PhotoVariantKind
  objectKey String           @unique @map("object_key") @db.VarChar(160)
  mediaType String           @default("image/webp") @map("media_type") @db.VarChar(40)
  width     Int
  height    Int
  sizeBytes Int              @map("size_bytes")
  sha256    String           @db.VarChar(64)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  photo     Photo            @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, kind])
  @@index([photoId])
  @@map("photo_variants")
}

model LegalAcceptance {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  termsVersion   String   @map("terms_version") @db.VarChar(40)
  privacyVersion String   @map("privacy_version") @db.VarChar(40)
  acceptedAt     DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, acceptedAt])
  @@map("legal_acceptances")
}
