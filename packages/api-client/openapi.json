{
  "components": {
    "schemas": {
      "AccountSummaryDto": {
        "properties": {
          "activeFamilyId": {
            "nullable": true,
            "type": "string"
          },
          "displayName": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "phoneMasked": {
            "example": "+86 138****8000",
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "phoneMasked",
          "activeFamilyId"
        ],
        "type": "object"
      },
      "ApiProblemDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "violations": {
            "items": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "traceId"
        ],
        "type": "object"
      },
      "CodeLoginRequestDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          },
          "phone": {
            "example": "13800138000",
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "phone",
          "challengeId",
          "code",
          "remember"
        ],
        "type": "object"
      },
      "CsrfTokenResponseDto": {
        "properties": {
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "csrfToken"
        ],
        "type": "object"
      },
      "DependencyHealthDto": {
        "properties": {
          "objectStorage": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "postgres": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "redis": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "postgres",
          "redis",
          "objectStorage"
        ],
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/DependencyHealthDto"
          },
          "service": {
            "example": "baby-growth-gallery-api",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "timestamp"
        ],
        "type": "object"
      },
      "PasswordLoginRequestDto": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          },
          "phone": {
            "example": "13800138000",
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "phone",
          "password",
          "remember"
        ],
        "type": "object"
      },
      "PasswordResetRequestDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          },
          "newPassword": {
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          },
          "phone": {
            "example": "13800138000",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "challengeId",
          "code",
          "newPassword"
        ],
        "type": "object"
      },
      "RegisterRequestDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "example": "123456",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          },
          "phone": {
            "example": "13800138000",
            "type": "string"
          },
          "privacyVersion": {
            "example": "draft-2026-09-10",
            "type": "string"
          },
          "termsVersion": {
            "example": "draft-2026-09-10",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "challengeId",
          "code",
          "password",
          "termsVersion",
          "privacyVersion"
        ],
        "type": "object"
      },
      "VerificationChallengeRequestDto": {
        "properties": {
          "phone": {
            "example": "13800138000",
            "type": "string"
          },
          "purpose": {
            "enum": [
              "REGISTER",
              "LOGIN",
              "RESET_PASSWORD"
            ],
            "type": "string"
          }
        },
        "required": [
          "phone",
          "purpose"
        ],
        "type": "object"
      },
      "VerificationChallengeResponseDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "expiresInSeconds": {
            "example": 300,
            "type": "number"
          },
          "resendAfterSeconds": {
            "example": 60,
            "type": "number"
          }
        },
        "required": [
          "challengeId",
          "expiresInSeconds",
          "resendAfterSeconds"
        ],
        "type": "object"
      }
    }
  },
